{
  "name": "career-atlas",
  "private": true,
  "version": "0.2.0",
  "description": "Career Atlas — a private, local-first, bilingual personal job tracker. Runs on your Mac; your data stays in a local SQLite database.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "build": "tsc -b && vite build && vite build -c vite.server.config.ts",
    "start:local": "node scripts/start-local.mjs",
    "stop:local": "node scripts/start-local.mjs --stop",
    "launcher:install": "node scripts/install-mac-launcher.mjs",
    "local": "node scripts/start-local.mjs --build-only && node dist/server/cli.mjs",
    "typecheck": "tsc -b",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "LIVE=1 playwright test live",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:generate": "drizzle-kit generate && node scripts/check-migrations.mjs",
    "db:check": "node scripts/check-migrations.mjs",
    "db:lock": "node scripts/check-migrations.mjs --lock",
    "db:test-upgrade": "node scripts/test-migration-upgrade.mjs",
    "db:seed:demo": "CAREER_ATLAS_INSTANCE=dev npm run local -- seed-demo",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "mcp:pack": "npx --yes @anthropic-ai/mcpb@2.1.2 validate integrations/claude-desktop/manifest.json && npx --yes @anthropic-ai/mcpb@2.1.2 pack integrations/claude-desktop dist/career-atlas.mcpb"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@hono/node-server": "1.19.17",
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.10",
    "i18next": "25.10.10",
    "lucide-react": "0.544.0",
    "playwright-core": "1.56.0",
    "radix-ui": "1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.65.0",
    "react-i18next": "15.7.4",
    "react-router": "7.18.4",
    "recharts": "3.2.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "undici": "7.29.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "22.18.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "drizzle-kit": "0.31.5",
    "tailwindcss": "4.1.14",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
